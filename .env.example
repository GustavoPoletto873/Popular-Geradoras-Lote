# Modelo de variáveis de ambiente. Copie para .env FORA de qualquer pasta compartilhada.
# NUNCA coloque valores reais aqui. Segredos de verdade ficam no cofre (Secret Manager).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: sqlite (padrão em dev/teste) ou postgres (obrigatório em homolog/prod)
DB_ENGINE=sqlite
DB_NAME=contabilidade_mensal
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Backend de cada operação da Britech: fake | api | browser
# (fake = Fase 1; api = Fase 2, só baixar_insumo; browser = Fases 3/4)
BRITECH_BACKEND_BAIXAR_INSUMO=fake
BRITECH_BACKEND_PROCESSAR_CONTABIL=fake
BRITECH_BACKEND_STATUS_PROCESSAMENTO=fake
BRITECH_BACKEND_BAIXAR_BALANCETE=fake

# Credenciais da Britech por administradora (padrão BRITECH_<SEGREDO_REF>_USER / _SENHA).
# Valores reais só no cofre / variável de ambiente da máquina — nunca neste arquivo.
# BRITECH_ID_CORRETORA_USER=
# BRITECH_ID_CORRETORA_SENHA=

# Cadastro de fundos (Monday): token só por variável de ambiente
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=6799176339

# Navegador (Playwright): headless em servidor; evidências (screenshot/trace) são sensíveis
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_EVIDENCIAS=

# Etapas 4 e 5: stub (homologação sem tocar Excel/Drive) | com (Excel real, Windows) | api (drive_api)
EXCEL_BACKEND=stub
DRIVE_BACKEND=stub
PERMITIR_STUBS_EXCEL_DRIVE=false
# Boleta do mês anterior: drive | local (árvore montada, só leitura)
EXCEL_ORIGEM=drive
BOLETA_RAIZ_LOCAL=
# drive_api (token SÓ no ambiente): em homologação, DRIVE_RAIZ_ID deve ser uma pasta HOMOLOG
DRIVE_API_URL=
DRIVE_API_TOKEN=
DRIVE_RAIZ_ID=

# Operações que ALTERAM algo fora do nosso sistema: dry-run ligado por padrão
DRY_RUN_PROCESSAR_CONTABIL=true
DRY_RUN_PUBLICAR_DRIVE=true
# Códigos de carteira (Britech) autorizados a ter o "Processar" clicado de verdade
ALLOWLIST_PROCESSAR_CONTABIL=

# Onde os workers gravam arquivos temporários por execução
STORAGE_ROOT=
